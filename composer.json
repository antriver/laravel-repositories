{
    "name": "antriver/laravel-repositories",
    "description": "Model repositories for Laravel.",
    "license": "MIT",
    "authors": [
        {
            "name": "Anthony Kuske",
            "homepage": "https://anthonykuske.com"
        }
    ],
    "autoload": {
        "psr-4": {
            "Antriver\\LaravelRepositories\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Antriver\\LaravelRepositories\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "laravel/framework": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "ext-sqlite3": "*",
        "phpunit/phpunit": "^10.5|^11.5|^12.5",
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.19|^9.0|^10.0|^11.0"
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    }
}
